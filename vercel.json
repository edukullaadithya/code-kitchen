{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "*.css",
      "use": "@vercel/static"
    },
    {
      "src": "app.js",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/auth/(.+)",
      "dest": "/api/auth/[action]?action=$1"
    },
    {
      "src": "/api/listings/(.+)",
      "dest": "/api/listings/[id]?id=$1"
    },
    {
      "src": "/api/inquiries/(.+)",
      "dest": "/api/inquiries/[id]?id=$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/runtime-config.js",
      "dest": "/api/runtime-config"
    },
    {
      "src": "/login",
      "dest": "/login.html"
    },
    {
      "src": "/",
      "dest": "/login.html"
    }
  ]
}