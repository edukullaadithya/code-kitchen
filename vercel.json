{
  "version": 2,
  "framework": null,
  "buildCommand": "",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/auth/:action", "destination": "/api/auth/[action]" },
    { "source": "/api/listings/:id", "destination": "/api/listings/[id]" },
    { "source": "/api/inquiries/:id", "destination": "/api/inquiries/[id]" },
    { "source": "/runtime-config.js", "destination": "/api/runtime-config" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/", "destination": "/login.html" }
  ]
}