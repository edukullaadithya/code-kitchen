{
  "version": 2,
  "framework": null,
  "buildCommand": "",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/auth/:action", "destination": "/api/auth/[action]" },
    { "source": "/api/listings/:id", "destination": "/api/listings/[id]" },
    { "source": "/api/inquiries/:id", "destination": "/api/inquiries/[id]" },
    { "source": "/api/favorites/:id", "destination": "/api/favorites/[id]" },
    { "source": "/api/favorites", "destination": "/api/favorites" },
    { "source": "/api/reviews/:id", "destination": "/api/reviews/[id]" },
    { "source": "/api/reviews", "destination": "/api/reviews" },
    { "source": "/api/messages/:id", "destination": "/api/messages/[id]" },
    { "source": "/api/messages", "destination": "/api/messages" },
    { "source": "/api/upload", "destination": "/api/upload" },
    { "source": "/api/notifications/email", "destination": "/api/notifications/email" },
    { "source": "/api/admin/users/:id", "destination": "/api/admin/users/[id]" },
    { "source": "/api/admin/users", "destination": "/api/admin/users" },
    { "source": "/api/admin/analytics", "destination": "/api/admin/analytics" },
    { "source": "/runtime-config.js", "destination": "/api/runtime-config" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/", "destination": "/login.html" }
  ]
}